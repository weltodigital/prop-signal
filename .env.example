# ---------------------------------------------------------------------------
# Prop Signal — copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Public. Safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No trailing slash. http://localhost:3000 locally, the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# The £29/month recurring price. `pnpm stripe:setup` creates one and prints it.
STRIPE_PRICE_ID=price_...

# Phase 2 onwards. Not read yet.
# PROPERTYDATA_API_KEY=
