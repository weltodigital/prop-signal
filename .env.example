# ---------------------------------------------------------------------------
# Prop Signal — copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Public. Safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fallback origin, used only where there is no request to read one from — cron
# jobs and CLI scripts. No trailing slash. Stripe redirects and magic links
# follow the host the user actually arrived on, so this does not need changing
# between localhost, previews and production.
NEXT_PUBLIC_SITE_URL=https://www.usepropsignal.com

# Server only. Never prefix these with NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# The £29/month recurring price. `pnpm stripe:setup` creates one and prints it.
STRIPE_PRICE_ID=price_...


# Phase 2 onwards. Read only by the credit wrapper, never by the web app.
PROPERTYDATA_API_KEY=
# Defaults are fine. Raise the rate limit only to match your actual plan.
# PROPERTYDATA_BASE_URL=https://api.propertydata.co.uk
# PROPERTYDATA_RATE_LIMIT_PER_10S=4
# PROPERTYDATA_RUN_CREDIT_CEILING=150

# Shared secret for the Vercel Cron endpoints.
CRON_SECRET=
